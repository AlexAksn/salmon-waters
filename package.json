{
  "name": "salmon-waters",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "data:geo": "python3 scripts/geo.py raw build && python3 scripts/waters.py && cp build/base.json build/waters.json public/data/",
    "prebuild": "node scripts/check-dfo.mjs && node scripts/fetch-notices.mjs",
    "check:dfo": "node scripts/check-dfo.mjs",
    "check:notices": "node scripts/fetch-notices.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
